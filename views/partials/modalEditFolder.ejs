<div class="modal my-4" tabindex="-1" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class=" modal-title">Edit Folder: <%= folder.name %>
                </h5>
            </div>
            <div class="modal-body">
                <form action="/folders/<%= folder.id %>" method="POST">
                    <label for="name">Folder Name:</label>
                    <input type="text" name="name" id="name" value="<%= folder.name %>" required>
                    <button type="submit" class="btn btn-success">Update Folder</button>
                </form>
            </div>
            <div class="modal-footer">
                <a href="/folders" role=" button" class="btn btn-primary">Close</a>
            </div>
        </div>
    </div>
</div>
<script>
    document.querySelector('.update').addEventListener('click', (event) => {
        var myModal = new bootstrap.Modal(document.getElementById('myModal'));
        myModal.show();
    });
</script>