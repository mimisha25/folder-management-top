<%- include('../partials/header') %>
    <%- include('../partials/sidebar') %>
        <main class="p-5">
            <% if (user) { %>
                <h1 class="mx-3">Your Folders</h1>
                <div class="d-flex flex-column flex-md-row p-4 gap-4 py-md-3  justify-content-center">
                    <% if(folders && folders.length> 0){%>
                        <% folders.forEach(folder=> { %>
                            <div class="list-group ">
                                <div class="list-group-item list-group-item-action d-flex gap-3 py-3 my-1 bg-success bg-gradient text-light"
                                    aria-current="true">
                                    <%- include('../assets/folderList') %>
                                        <div class="d-flex gap-2 w-100 justify-content-between flex-row ">
                                            <div>
                                                <h4 class="mb-0"> <a class="text-decoration-none text-light"
                                                        href="/folders/<%= folder.id %>">
                                                        <%= folder.name %>
                                                    </a></h4>
                                            </div>
                                            <% if (folder.shareToken) { %>
                                                <div class="mb-0 text-center ">
                                                    <a href="http://localhost:3000/share/<%= folder.shareToken %>"
                                                        class="fst-italic link-light link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover text-light">
                                                        Link
                                                    </a>
                                                    <% } else { %>
                                                        <%- include('../partials/generateShareLink') %>
                                                </div>
                                                <% } %>
                                        </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
                </div>
                <div class="card my-4  shadow-sm border-primary p-3">
                    <h4 class="mx-auto">Create new folder:</h4>
                    <form action="/folders" method="POST">
                        <div class="d-flex flex-row ">
                            <button type="button" class="w-100  mx-2  btn  btn-primary">Name</button>
                            <input type="text" name="name" id="name" required>
                            <button type="submit" class="w-100  mx-2  btn  btn-primary">Create</button>
                        </div>
                    </form>
                </div>
                <% } %>
                    <%- include('../partials/footer') %>